# Copy this file to .env and fill it in. Never commit .env.

# Admin panel password (required in production). Use a long, unique one.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Random string used to sign admin sessions (required in production).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public address of the site, no trailing slash (required in production).
# Used for sitemap.xml, canonical links and social previews.
SITE_URL=https://your-domain.com

# Optional
PORT=8787
# Where content (JSON) and uploaded images are stored. Point this at a persistent disk in production.
DATA_DIR=./data
# Optional: Slack/Discord/Zapier webhook that receives each trip enquiry.
ENQUIRY_WEBHOOK_URL=
